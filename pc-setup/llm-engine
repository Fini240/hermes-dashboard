#!/bin/bash
# Switch the GPU between Ollama and Strata, or report which one has it.
#
#   llm-engine ollama | strata    switch (prints "ok")
#   llm-engine h3                 lend the GPU to the H3 video server (remembers who had it)
#   llm-engine restore            give it back to that engine after the videos
#   llm-engine probe              key=value lines for the dashboard's PROBE
#
# Lives on the PC, like rgb-apply, so the dashboard composes no service names
# or addresses itself. Strata's address is read from its own config file.
set -eu
STRATA_DIR=${STRATA_DIR:-/home/user/Strata}
STRATA_CFG=${STRATA_CFG:-$STRATA_DIR/strata-active.json}
USER_NAME=user   # the account that owns Ollama's user unit
UID_NUM=1000
PREV=/run/llm-engine.prev   # who had the GPU before H3 borrowed it

# A video render needs the whole card for minutes; never pull it away mid-render.
h3_rendering() { pgrep -f "sd-cli -M vid_gen" >/dev/null; }
refuse_if_rendering() {
    if h3_rendering; then
        echo "H3 is rendering a video - cancel it on the Video tab or wait until it is done" >&2
        exit 1
    fi
}
# An explicit engine choice ends H3's loan.
end_h3_loan() { systemctl stop h3-awake.service 2>/dev/null || true; rm -f "$PREV"; }

# Ollama runs as that account's user unit (see 10-ollama-gpu), not a system service.
ollama_ctl() {
    runuser -u "$USER_NAME" -- env \
        XDG_RUNTIME_DIR="/run/user/$UID_NUM" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_NUM/bus" \
        systemctl --user "$@"
}

strata_cfg() {
    python3 - "$STRATA_CFG" "$1" <<'EOF' 2>/dev/null
import json, sys
c = json.load(open(sys.argv[1]))
print({"url": "http://%s:%s" % (c.get("host") or "127.0.0.1", c.get("port") or 8080),
       "key": c.get("api_key") or "",
       "model": c.get("model_name") or "strata"}[sys.argv[2]])
EOF
}

case "${1:-}" in
    strata)
        # Serialize switches from multiple dashboards; accept only known variants.
        exec 9>/run/llm-engine.lock
        flock -w 90 9
        refuse_if_rendering
        end_h3_loan
        variant=${2:-}
        if [ -n "$variant" ]; then
            case "$variant" in q2_0|coder-iq1_m) ;; *) echo "unknown Strata model" >&2; exit 2 ;; esac
            cfg="$STRATA_DIR/strata-$variant.json"
            [ -f "$cfg" ] || { echo "Strata model config is missing" >&2; exit 1; }
            python3 - "$cfg" <<'EOF'
import json, sys
from pathlib import Path
c = json.load(open(sys.argv[1]))
a = c["args"]
for flag in ("--native", "--ple-gguf"):
    if not Path(a[a.index(flag) + 1]).is_file():
        raise SystemExit("Strata model download is incomplete")
if not Path(a[a.index("--pack") + 1], "index.txt").is_file():
    raise SystemExit("Strata model preparation is incomplete")
EOF
            if [ "$(readlink -f "$STRATA_CFG" 2>/dev/null)" != "$cfg" ]; then
                systemctl stop strata.service
                ln -sfn "$cfg" "$STRATA_CFG.next"
                mv -Tf "$STRATA_CFG.next" "$STRATA_CFG"
            fi
        fi
        ollama_ctl stop ollama.service
        systemctl start strata.service && echo ok
        ;;
    ollama)
        exec 9>/run/llm-engine.lock
        flock -w 90 9
        refuse_if_rendering
        end_h3_loan
        systemctl stop strata.service
        ollama_ctl start ollama.service && echo ok
        ;;
    h3)
        exec 9>/run/llm-engine.lock
        flock -w 90 9
        if [ "$(systemctl is-active h3-awake.service 2>/dev/null)" != active ]; then
            if [ "$(systemctl is-active strata.service 2>/dev/null)" = active ]; then
                v=$(basename "$(readlink -f "$STRATA_CFG")" .json); v=${v#strata-}
                echo "strata $v" > "$PREV"
            elif [ "$(ollama_ctl is-active ollama.service 2>/dev/null)" = active ]; then
                echo "ollama" > "$PREV"
            else
                echo "none" > "$PREV"
            fi
            systemctl stop strata.service
            ollama_ctl stop ollama.service
            systemctl start h3-awake.service
        fi
        echo ok
        ;;
    restore)
        exec 9>/run/llm-engine.lock
        flock -w 90 9
        refuse_if_rendering
        prev=$(cat "$PREV" 2>/dev/null || echo strata)
        systemctl stop h3-awake.service 2>/dev/null || true
        rm -f "$PREV"
        flock -u 9
        case "$prev" in
            strata*) set -- $prev; exec "$0" strata ${2:-} ;;
            ollama)  exec "$0" ollama ;;
            *)       echo ok ;;
        esac
        ;;
    probe)
        echo "engine_avail=1"
        echo "engine_h3=$(systemctl is-active h3-awake.service 2>/dev/null || true)"
        h3_rendering && echo "h3_state=rendering"
        s=$(systemctl is-active strata.service 2>/dev/null || true)
        o=$(ollama_ctl is-active ollama.service 2>/dev/null || true)
        echo "engine_strata=$s"
        echo "engine_ollama=$o"
        echo "strata_model=$(strata_cfg model)"
        for variant in q2_0 coder-iq1_m; do
            if [ -f "$STRATA_DIR/strata-$variant.json" ] && [ -f "${STRATA_DIR}-data/packs/$variant/index.txt" ]; then
                echo "strata_installed_${variant//-/_}=1"
            fi
        done
        if [ "$s" = active ]; then
            # With an api_key in the config every endpoint wants it, /status
            # included. While the model is still loading (~80 s) the server does
            # not answer yet: report that as "loading".
            st=$(curl -s --max-time 2 -H "Authorization: Bearer $(strata_cfg key)" \
                 "$(strata_cfg url)/status" 2>/dev/null || true)
            if [ -n "$st" ]; then
                # /status: "busy", plus tokens_per_s once the first token is out
                # (before that it is still reading the prompt).
                printf '%s' "$st" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "busy" not in d:
    print("strata_state=error")
elif not d["busy"]:
    print("strata_state=idle")
else:
    tps = d.get("tokens_per_s")
    print("strata_state=%s" % ("generating" if tps else "reading"))
    print("strata_tok_s=%s" % (tps or ""))' 2>/dev/null
            else
                echo "strata_state=loading"
            fi
        fi
        ;;
    *)
        echo "usage: llm-engine ollama|strata [q2_0|coder-iq1_m]|h3|restore|probe" >&2
        exit 2
        ;;
esac
