# ─── which machine is being monitored ────────────────────────────────────────
# Display name: browser tab, page header, wake button.
HERMES_PC_NAME=my-pc
# Address used for the SSH probe that reads GPU/CPU/RAM/power from sysfs.
# Prefer a LAN address: Tailscale SSH demands a periodic browser re-auth and
# HANGS until it gets one, which makes the probe time out.
HERMES_PC_HOST=192.168.1.50
# Ollama's address. Often NOT the same as HERMES_PC_HOST — Ollama may bind only
# a tailnet address while SSH goes over the LAN.
HERMES_OLLAMA=http://100.x.y.z:11434
# Label on the GPU card. Ollama reports no GPU model, so this is cosmetic.
HERMES_GPU_LABEL=RX 6700 XT

# ─── wake-on-LAN ─────────────────────────────────────────────────────────────
# The PC's wired NIC MAC. Verify with `ethtool <iface> | grep Wake-on` — it must
# report "g" or the magic packet is ignored.
HERMES_PC_MAC=aa:bb:cc:dd:ee:ff
# The PC's subnet. Used to detect "am I on the PC's LAN" and as the broadcast
# target (<prefix>255). A magic packet is layer-2 and does NOT cross a VPN.
HERMES_LAN_PREFIX=192.168.1.
# When this dashboard is NOT on the PC's LAN, it asks another dashboard that is.
# direct=1 stops the two relaying to each other forever. Leave blank if unused.
HERMES_WAKE_RELAY_URL=

# ─── SSH ─────────────────────────────────────────────────────────────────────
HERMES_SSH_KEY=/ssh/id_ed25519
HERMES_KNOWN_HOSTS=/ssh/known_hosts

# ─── Hermes token stats (optional) ───────────────────────────────────────────
# Where Hermes' state.db lives, as user@host:/abs/path. Only the
# session_model_usage table is exported (~24 KB), not the whole database.
# Leave blank to disable the token panels entirely.
HERMES_STATE_SYNC=
HERMES_STATE_DB=/data/state.db
HERMES_STATE_SYNC_SECONDS=15

# When the PC dual-boots Windows, the Windows account to ssh in as. Windows
# cannot run a Tailscale SSH server, so this uses OpenSSH Server with the same
# key. The probe and power actions switch automatically based on which OS
# answers, so this is only consulted for the Windows half.
HERMES_WIN_SSH_USER=user

# Strata (optional second engine, see pc-setup/llm-engine). Its /metrics feeds the
# model-state card while it runs; the key stays server-side, never sent to the browser.
HERMES_STRATA_URL=http://192.168.1.50:8080
HERMES_STRATA_KEY=

# The Hermes agent's API server (gateway platform api_server, on the Mac). The page's
# chat can talk to it ("Hermes agent"); it thinks with whichever engine holds the PC's GPU.
# Chat and model settings are only accepted from Tailscale clients (100.64.0.0/10).
HERMES_AGENT_URL=http://100.64.0.10:8642
HERMES_AGENT_KEY=
# Hermes provider names for the two engines, and the Ollama model a chat gets when none is loaded
HERMES_AGENT_PROVIDER_STRATA=custom:strata
HERMES_AGENT_PROVIDER_OLLAMA=custom:pc-ollama
HERMES_OLLAMA_CHAT_MODEL=qwen3.5:9b
# h3-engine on the PC (Video tab: MiniMax H3 clips with sound); key from ~/h3-engine/config.json there
HERMES_H3_URL=
HERMES_H3_KEY=
